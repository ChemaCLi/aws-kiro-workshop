# Variables de entorno del servicio de sincronización en la nube (sync-api).
# Copia este archivo a .env y rellena cada valor. Ninguno es secreto: todo lo que este
# servicio necesita para validar un access token de Cognito es público (el JWKS del User Pool
# también lo es, por diseño de OIDC).

# Mismos valores que exercise/.env (PUBLIC_COGNITO_*): el User Pool y el App Client cuyos
# access token este servicio acepta.
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_REGION=us-east-1
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Orígenes permitidos separados por comas: el sitio real publicado y, para desarrollo,
# localhost. Ejemplo: https://tu-dominio.cloudfront.net,http://localhost:4321
ALLOWED_ORIGINS=https://tu-dominio.cloudfront.net

# Puerto en el que escucha Express. No aplica si corre como Lambda Web Function.
PORT=8787

# Tabla de DynamoDB donde vive el progreso de cada persona (clave: sub de Cognito). Por
# defecto focus-garden-cloud-sync si se omite.
SYNC_TABLE_NAME=focus-garden-cloud-sync
