# Variables de entorno públicas del frontend (Astro las expone al navegador porque
# empiezan con PUBLIC_; ver https://docs.astro.build/en/guides/environment-variables/).
# Copia este archivo a .env y rellena cada valor con los datos reales de Cognito y del
# puente OIDC. Ninguno es secreto (ver src/core/auth-config.js y dependencies-policy.md):
# sin .env, la app sigue funcionando con los placeholders de ejemplo del código.

# Id del User Pool de Cognito. AWS Console > Cognito > User pools > tu pool > "User pool ID".
PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX

# Id del App Client público (sin secreto) del User Pool.
PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Dominio del Hosted UI de Cognito, con https:// y sin barra final.
# Ejemplo: https://focus-garden.auth.us-east-1.amazoncognito.com
PUBLIC_COGNITO_DOMAIN=https://focus-garden.auth.us-east-1.amazoncognito.com

# Endpoint público del puente OIDC de GitHub (ver oidc-bridge/README.md), con https:// y
# sin barra final. Es el mismo valor que ISSUER en oidc-bridge/.env.
PUBLIC_OIDC_BRIDGE_ENDPOINT=https://oidc-bridge.example.com
