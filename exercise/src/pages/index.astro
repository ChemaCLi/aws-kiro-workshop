---
// Landing (index.astro). Página aparte de la app: aquí solo se presenta el producto y se
// invita a entrar. La app vive en app.astro. Lo que es puramente estático (la escalera de
// plantas, los chips de tipo de tarea, las estrellas, los números del hero) se resuelve aquí
// en build-time a partir de las reglas de core/rules.js; lo que depende de localStorage o de
// la hora del visitante sigue siendo un script de cliente (ver abajo).
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/landing.css';
import { PLANTS, TASK_TYPES, starField } from '../core/rules.js';

const lastPlantIndex = PLANTS.length - 1;

// Estrellas con posición y parpadeo deterministas (ver core/rules.js): la landing y el jardín
// de la app comparten la misma función, así que el cielo nocturno se ve igual en ambos.
const stars = starField();
---
<BaseLayout
  title="Focus Garden · Tareas con pomodoro que hacen crecer tu jardín"
  description="Focus Garden es una app open source: anota tareas, enfócate con rondas pomodoro y mira crecer un jardín 3D por cada tarea terminada. Sin cuenta, gratis."
  bodyClass="bg-cream text-ink"
>
  <Fragment slot="head">
    <meta property="og:title" content="Focus Garden" />
    <meta property="og:description" content="Cada ronda de enfoque hace crecer tu jardín. Open source y sin cuenta." />
    <meta property="og:type" content="website" />
  </Fragment>

  <!-- Barra superior -->
  <header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5">
      <a href="#inicio" class="flex min-h-11 items-center gap-2 text-lg font-extrabold tracking-tight">
        <span class="text-2xl" aria-hidden="true">🌱</span> Focus Garden
      </a>
      <nav class="hidden items-center gap-8 text-sm font-bold text-ink/70 md:flex" aria-label="Secciones de la página">
        <a href="#como-funciona" class="inline-flex min-h-11 items-center hover:text-moss">Cómo funciona</a>
        <a href="#funciones" class="inline-flex min-h-11 items-center hover:text-moss">Funciones</a>
        <a href="#open-source" class="inline-flex min-h-11 items-center hover:text-moss">Open source</a>
      </nav>
      <button type="button" data-enter class="press h-11 rounded-full bg-moss px-5 text-sm font-bold text-white">Entrar</button>
    </div>
  </header>

  <main>
    <!-- Hero: el texto a la izquierda y el jardín 3D a la derecha -->
    <section id="inicio" class="hero-sky" data-period="midday" aria-labelledby="hero-title">
      <div class="sky-stars" aria-hidden="true">
        <span class="shooting-star"></span>
        {stars.map((s) => (
          <i
            class={s.bright ? 'is-bright' : undefined}
            style={`--x:${s.x.toFixed(1)}%;--y:${s.y.toFixed(1)}%;--s:${s.size}px;--d:${s.twinkleSeconds.toFixed(1)}s;--delay:${s.delaySeconds.toFixed(1)}s`}
          ></i>
        ))}
      </div>
      <div class="sky-body" aria-hidden="true"></div>

      <div class="hero-content mx-auto grid max-w-6xl items-center gap-4 px-5 pb-20 pt-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-6 lg:pb-28 lg:pt-14">
        <div>
          <p class="hero-badge inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-sm font-bold">
            <span aria-hidden="true">🌱</span> Gratis · Open source · Sin cuenta
          </p>
          <h1 id="hero-title" class="mt-5 text-[44px] font-extrabold leading-[1.02] tracking-tight sm:text-6xl lg:text-[66px]">
            Cada ronda de enfoque <span class="hero-accent">hace crecer</span> tu jardín
          </h1>
          <p class="hero-muted mt-5 max-w-xl text-lg font-medium leading-relaxed">
            Anota tus tareas, enfócate con rondas pomodoro y mira cómo cada tarea terminada brota como una planta en tu isla 3D.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <button type="button" data-enter class="btn-primary press">
              <span data-enter-label>Empezar mi jardín</span>
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </button>
            <a href="#como-funciona" class="btn-primary btn-primary--light">Cómo funciona</a>
          </div>

          <dl class="mt-9 flex max-w-md items-start gap-5">
            <div class="flex flex-col-reverse">
              <dt class="hero-muted text-xs font-bold uppercase tracking-wide">Plantas</dt>
              <dd class="text-3xl font-extrabold tabular-nums">{PLANTS.length}</dd>
            </div>
            <div class="hero-divider h-10 w-px"></div>
            <div class="flex flex-col-reverse">
              <dt class="hero-muted text-xs font-bold uppercase tracking-wide">Tipos de tarea</dt>
              <dd class="text-3xl font-extrabold tabular-nums">{TASK_TYPES.length}</dd>
            </div>
            <div class="hero-divider h-10 w-px"></div>
            <div class="flex flex-col-reverse">
              <dt class="hero-muted text-xs font-bold uppercase tracking-wide">Cuentas necesarias</dt>
              <dd class="text-3xl font-extrabold tabular-nums">0</dd>
            </div>
          </dl>

          <p data-local-note class="hero-muted mt-6 text-sm font-medium">Tus datos se guardan solo en este dispositivo. Ideal para probar.</p>
          <a href="./app.html#/cuenta" data-act="account" class="hero-accent press mt-1 inline-flex min-h-11 items-center rounded-lg text-left text-sm font-bold underline decoration-2 underline-offset-4">
            Mantén vivo tu jardín, lleva tu progreso contigo
          </a>
        </div>

        <!-- Jardín 3D decorativo: a la derecha en escritorio, debajo del texto en el teléfono -->
        <div class="relative">
          <div data-hero-garden class="h-[340px] sm:h-[440px] lg:h-[600px]"></div>
          <div class="hud-chip pointer-events-none absolute left-0 top-6 flex items-center gap-2 rounded-2xl border border-line bg-paper/90 px-3.5 py-2 text-xs font-bold text-ink shadow-lg backdrop-blur sm:left-4 sm:text-sm" aria-hidden="true">
            <span class="h-2.5 w-2.5 animate-pulse rounded-full bg-leaf"></span> 🍅 Ronda en curso · 25:00
          </div>
          <div class="hud-chip hud-chip--b pointer-events-none absolute bottom-8 right-0 rounded-2xl border border-line bg-paper/90 px-3.5 py-2 text-xs font-bold text-ink shadow-lg backdrop-blur sm:right-4 sm:text-sm" aria-hidden="true">
            🌸 ¡Creció una sakura en tu jardín!
          </div>
        </div>
      </div>
    </section>

    <!-- Cómo funciona -->
    <section id="como-funciona" class="scroll-mt-16 py-20" aria-labelledby="como-title">
      <div class="mx-auto max-w-6xl px-5">
        <p class="text-xs font-bold uppercase tracking-wide text-moss">Cómo funciona</p>
        <h2 id="como-title" class="mt-2 max-w-2xl text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">Tres pasos y tu isla empieza a florecer</h2>

        <ol class="mt-10 grid gap-4 md:grid-cols-3">
          <li class="rounded-3xl border border-line bg-paper p-6">
            <span class="grid h-11 w-11 place-items-center rounded-2xl bg-moss text-lg font-extrabold text-white">1</span>
            <h3 class="mt-4 text-xl font-extrabold">Anota lo que toca</h3>
            <p class="mt-2 leading-relaxed text-ink/70">Crea una tarea en un toque y clasifícala: trabajo, personal, salud, social u ocio. Sin formularios largos.</p>
          </li>
          <li class="rounded-3xl border border-line bg-paper p-6">
            <span class="grid h-11 w-11 place-items-center rounded-2xl bg-moss text-lg font-extrabold text-white">2</span>
            <h3 class="mt-4 text-xl font-extrabold">Enfócate una ronda</h3>
            <p class="mt-2 leading-relaxed text-ink/70">Toca ▶ en la tarea y arranca una ronda pomodoro. Con música lofi si quieres, y una campanita al terminar.</p>
          </li>
          <li class="rounded-3xl border border-line bg-paper p-6">
            <span class="grid h-11 w-11 place-items-center rounded-2xl bg-moss text-lg font-extrabold text-white">3</span>
            <h3 class="mt-4 text-xl font-extrabold">Mira crecer tu jardín</h3>
            <p class="mt-2 leading-relaxed text-ink/70">Al terminar la tarea, brota una planta en tu isla 3D. Mientras más rondas le dedicas, más grande es.</p>
          </li>
        </ol>

        <div class="mt-6 rounded-3xl border border-line bg-paper p-6 sm:p-8">
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
              <h3 class="text-xl font-extrabold">Tu esfuerzo se ve en la isla</h3>
              <p class="mt-1 max-w-xl text-ink/70">Toda tarea terminada siembra al menos pasto. Mientras más rondas le dediques, más grande es la planta.</p>
            </div>
          </div>
          <ul class="mt-6 grid grid-cols-3 gap-3 sm:grid-cols-6" aria-label="Planta según las rondas de la tarea">
            {PLANTS.map((plant, index) => (
              <li class={`plant-tile rounded-2xl border ${index === lastPlantIndex ? 'border-pink-200 bg-pink-50' : 'border-line bg-cream'} p-3 text-center`}>
                <p class="text-4xl" aria-hidden="true">{plant.emoji}</p>
                <p class="mt-2 text-sm font-extrabold">{plant.label}</p>
                <p class="text-xs font-bold"><span class="text-ink/50">{index === lastPlantIndex ? `${plant.rounds}+` : plant.rounds}</span> 🍅</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Funciones -->
    <section id="funciones" class="scroll-mt-16 border-y border-line bg-paper py-20" aria-labelledby="funciones-title">
      <div class="mx-auto max-w-6xl px-5">
        <p class="text-xs font-bold uppercase tracking-wide text-moss">Funciones</p>
        <h2 id="funciones-title" class="mt-2 max-w-2xl text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">Lo necesario para enfocarte, nada que estorbe</h2>

        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <article class="feature-card rounded-3xl border border-line bg-cream p-6">
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-white text-2xl shadow-sm" aria-hidden="true">📝</span>
            <h3 class="mt-4 text-lg font-extrabold">Tareas por tipo</h3>
            <p class="mt-2 leading-relaxed text-ink/70">Completa con un toque, elimina deslizando y deshaz si te equivocaste. Filtra por tipo cuando quieras ver solo una parte de tu día.</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {TASK_TYPES.map((type) => (
                <span class="inline-flex items-center gap-1.5 rounded-full border border-line bg-white px-3 py-1 text-xs font-bold">
                  <span class="h-2 w-2 rounded-full" style={`background:${type.color}`}></span>{type.short ?? type.label}
                </span>
              ))}
            </div>
          </article>

          <article class="feature-card rounded-3xl border border-line bg-cream p-6">
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-white text-2xl shadow-sm" aria-hidden="true">🍅</span>
            <h3 class="mt-4 text-lg font-extrabold">Pomodoro que no se pierde</h3>
            <p class="mt-2 leading-relaxed text-ink/70">Rondas de 5 a 60 minutos. El reloj usa la hora de fin, así que sigue contando aunque cambies de pestaña, bloquees la pantalla o recargues.</p>
          </article>

          <article class="feature-card rounded-3xl border border-line bg-cream p-6">
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-white text-2xl shadow-sm" aria-hidden="true">🏝️</span>
            <h3 class="mt-4 text-lg font-extrabold">Un jardín 3D que es tuyo</h3>
            <p class="mt-2 leading-relaxed text-ink/70">Una isla flotante con una parcela por tarea terminada. Gírala, acércala y toca una planta para recordar qué lograste. La isla crece contigo.</p>
          </article>

          <article class="feature-card rounded-3xl border border-line bg-cream p-6">
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-white text-2xl shadow-sm" aria-hidden="true">📊</span>
            <h3 class="mt-4 text-lg font-extrabold">Estadísticas con calma</h3>
            <p class="mt-2 leading-relaxed text-ink/70">Tareas terminadas, rondas, minutos de foco y racha de días. Una dona por tipo y la tendencia de los últimos 7 días.</p>
          </article>

          <article class="feature-card rounded-3xl border border-line bg-cream p-6">
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-white text-2xl shadow-sm" aria-hidden="true">🎧</span>
            <h3 class="mt-4 text-lg font-extrabold">Música lofi sin descargas</h3>
            <p class="mt-2 leading-relaxed text-ink/70">Las melodías se generan en tu navegador con Tone.js. No hay archivos de audio, y la música baja sola cuando suena la campanita.</p>
          </article>

          <article class="feature-card rounded-3xl border border-line bg-cream p-6">
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-white text-2xl shadow-sm" aria-hidden="true">📱</span>
            <h3 class="mt-4 text-lg font-extrabold">Pensada para el celular</h3>
            <p class="mt-2 leading-relaxed text-ink/70">Se diseñó primero para el teléfono, se instala en tu pantalla de inicio y se adapta a tableta y escritorio. Tus datos viven en tu dispositivo.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Open source -->
    <section id="open-source" class="scroll-mt-16 bg-ink py-20 text-cream" aria-labelledby="oss-title">
      <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 lg:grid-cols-2">
        <div>
          <p class="text-xs font-bold uppercase tracking-wide text-leaf">Open source</p>
          <h2 id="oss-title" class="mt-2 text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">Código abierto, de principio a fin</h2>
          <p class="mt-4 text-lg leading-relaxed text-cream/75">
            Focus Garden es open source: léelo, pruébalo, cópialo y mejóralo. Nació en el taller «Todos pueden programar con Kiro» del AWS User Group Orizaba, como ejemplo de una app real hecha paso a paso.
          </p>
          <ul class="mt-6 space-y-3 font-medium text-cream/85">
            <li class="flex gap-3"><span class="text-leaf" aria-hidden="true">✓</span> Astro, HTML y JavaScript, sin frameworks de interfaz</li>
            <li class="flex gap-3"><span class="text-leaf" aria-hidden="true">✓</span> Tailwind integrado al build; Tone.js y Three.js como paquetes, cada uno con su respaldo si falla</li>
            <li class="flex gap-3"><span class="text-leaf" aria-hidden="true">✓</span> Astro + Vite con un paso de build sencillo: se publica como sitio estático en cualquier hosting</li>
            <li class="flex gap-3"><span class="text-leaf" aria-hidden="true">✓</span> Sin cuenta obligatoria ni servidor: tus datos pueden quedarse solo en tu dispositivo</li>
          </ul>
          <a href="https://github.com/ChemaCLi/aws-kiro-workshop" target="_blank" rel="noopener noreferrer"
            class="btn-primary btn-primary--light mt-8">Ver el código en GitHub <span aria-hidden="true">↗</span></a>
        </div>

        <figure class="overflow-hidden rounded-3xl border border-white/10 bg-black/30">
          <div class="flex items-center gap-2 border-b border-white/10 px-4 py-3" aria-hidden="true">
            <span class="h-3 w-3 rounded-full bg-[#e5604f]"></span><span class="h-3 w-3 rounded-full bg-[#f0a52a]"></span><span class="h-3 w-3 rounded-full bg-[#3fb56b]"></span>
          </div>
          <pre class="overflow-x-auto p-5 text-[13px] leading-7 text-cream/90 sm:text-sm"><code><span class="text-cream/40"># Pruébalo en tu máquina</span>
<span class="text-leaf">$</span> git clone https://github.com/ChemaCLi/aws-kiro-workshop.git
<span class="text-leaf">$</span> cd aws-kiro-workshop/exercise
<span class="text-leaf">$</span> npm install
<span class="text-leaf">$</span> npm run dev
<span class="text-cream/40"># abre la URL que imprime Astro (http://localhost:4321)</span></code></pre>
          <figcaption class="sr-only">Comandos para ejecutar Focus Garden en tu computadora</figcaption>
        </figure>
      </div>
    </section>

    <!-- Llamada final -->
    <section class="bg-moss py-16 text-center text-white" aria-labelledby="cta-title">
      <div class="mx-auto max-w-2xl px-5">
        <p class="text-5xl" aria-hidden="true">🌳</p>
        <h2 id="cta-title" class="mt-4 text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">Tu primera planta está a una tarea de distancia</h2>
        <p class="mt-3 text-lg text-white/75">Sin registro, sin instalar nada. Abre la app y siembra tu primera tarea.</p>
        <button type="button" data-enter class="btn-primary btn-primary--light mt-8">
          <span data-enter-label>Empezar mi jardín</span>
        </button>
      </div>
    </section>
  </main>

  <footer class="bg-ink py-8 text-sm text-cream/60">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-5">
      <p>🌱 Focus Garden · Hecho en el taller de AWS User Group Orizaba</p>
      <a href="https://github.com/ChemaCLi/aws-kiro-workshop" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center font-bold hover:text-cream">Código en GitHub ↗</a>
    </div>
  </footer>

  <script>
    import { heroPlots, timePeriodFor } from '../core/rules.js';
    import { store } from '../core/store.js';
    import { markGuestEntry } from '../core/guest-entry.js';
    import { mountHeroGarden } from '../views/hero-garden.js';
    import { openEnterChoiceSheet } from '../views/landing-sheets.js';

    const APP_URL = './app.html';

    /** Cada cuánto se revisa si el día cambió de franja mientras la landing sigue abierta. */
    const PERIOD_CHECK_MS = 60_000;

    const ENTER_LABEL_WITH_DATA = 'Continuar mi jardín';
    const ENTER_LABEL_WITHOUT_DATA = 'Empezar mi jardín';

    const hero = document.querySelector('#inicio');
    const heroGarden = mountHeroGarden(document.querySelector('[data-hero-garden]'));
    let currentPeriod = null;
    let isEntering = false; // evita abrir el recordatorio dos veces con toques repetidos

    /** Recalcula la franja con la hora local; solo toca el cielo y la escena si realmente cambió. */
    function applyPeriod() {
      const period = timePeriodFor(new Date());
      if (period === currentPeriod) return;
      currentPeriod = period;
      hero.dataset.period = period;
      heroGarden.setPeriod(period);
    }

    /** "Continuar" si ya hay tareas o rondas; si no, la invitación a empezar y la nota de datos locales. */
    function renderEntryState() {
      const hasData = store.hasLocalData();
      for (const label of document.querySelectorAll('[data-enter-label]')) {
        label.textContent = hasData ? ENTER_LABEL_WITH_DATA : ENTER_LABEL_WITHOUT_DATA;
      }
      document.querySelector('[data-local-note]').hidden = hasData;
      heroGarden.setPlots(heroPlots(store.state));
    }

    /** Entrar siempre pregunta primero: iniciar sesión, o seguir sin cuenta (con su aviso en la app). */
    function enterApp() {
      if (isEntering) return;
      isEntering = true;
      openEnterChoiceSheet({
        onSignIn: () => location.assign(`${APP_URL}#/cuenta`),
        onGuest: () => {
          markGuestEntry();
          location.assign(APP_URL);
        },
      });
    }

    // El Create_Account_Button (data-act="account") es un enlace directo a app.html#/cuenta, así
    // que solo se intercepta "Entrar" para preguntar antes de abrir la app.
    document.addEventListener('click', (event) => {
      if (event.target.closest('[data-enter]')) enterApp();
    });

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') applyPeriod();
    });

    // Al volver con "atrás" desde la app el navegador puede restaurar esta página de su caché con
    // datos viejos (por ejemplo, sin "Continuar"). Se recarga para leer lo que quedó guardado.
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) location.reload();
    });

    renderEntryState();
    applyPeriod();
    setInterval(applyPeriod, PERIOD_CHECK_MS);
  </script>
</BaseLayout>
