# Variables de entorno del puente OIDC de GitHub.
# Copia este archivo a .env y rellena cada valor. No subas .env al repositorio;
# los secretos viven solo en el servidor, nunca en el frontend (auth-config.js).

# Credenciales de la OAuth App de GitHub (GitHub > Settings > Developer settings > OAuth Apps).
GITHUB_CLIENT_ID=tu-github-client-id
GITHUB_CLIENT_SECRET=tu-github-client-secret

# Clave privada RS256 con la que el puente firma los ID token OIDC que Cognito valida.
# Pega la clave PEM completa en una sola linea usando \n como salto de linea,
# o cambia el cargador para leerla de un archivo.
OIDC_SIGNING_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Identificador de la clave de firma (kid), publicado en /.well-known/jwks.json.
OIDC_KEY_ID=tu-key-id

# Origenes permitidos separados por comas. Debe incluir el redirect de Cognito.
# Ejemplo: https://focus-garden.auth.us-east-1.amazoncognito.com,https://tu-dominio.example.com
ALLOWED_ORIGINS=https://tu-dominio-de-cognito.example.com

# Issuer OIDC del puente: la URL publica base del servicio (sin barra final).
# Ejemplo: https://oidc-bridge.example.com
ISSUER=https://oidc-bridge.example.com

# Puerto en el que escucha el servidor Express. No aplica si corre como Lambda Web Function.
PORT=8787

# Tabla de DynamoDB donde vive el authorization code efímero entre /callback y /token (ver
# "Tabla de DynamoDB para los authorization code" en el README). Para desarrollo local sin una
# cuenta de AWS real, usa DynamoDB Local y agrega también AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000.
CODE_STORE_TABLE_NAME=focus-garden-oidc-bridge-codes
