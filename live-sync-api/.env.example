# Variables de entorno de las dos funciones Lambda de live-sync-api (router.js y authorizer.js).
# A diferencia de oidc-bridge/sync-api (Lambda Web Functions, con su propio servidor local y
# npm start), estas son Event Functions: no hay un servidor que lea este archivo directamente.
# Este .env.example documenta qué variables pasarle con --environment al crear/actualizar cada
# función (ver el script de aprovisionamiento). Ninguna es secreta.

# Mismos valores que exercise/.env (PUBLIC_COGNITO_*): el User Pool y el App Client cuyos
# access token acepta el authorizer. Van en AMBAS funciones (el router también los necesita
# indirectamente si en el futuro valida algo más; por ahora solo los usa el authorizer).
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_REGION=us-east-1
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Nombres de las tablas de DynamoDB. Por defecto focus-garden-connections/focus-garden-live-timer
# si se omiten. Solo las usa router.js.
CONNECTIONS_TABLE_NAME=focus-garden-connections
LIVE_TIMER_TABLE_NAME=focus-garden-live-timer

# Endpoint de administración de conexiones de API Gateway (para mandar mensajes a los
# dispositivos): https://{api-id}.execute-api.{region}.amazonaws.com/{stage}. Solo se conoce
# una vez creada la API WebSocket; solo lo usa router.js.
APIGW_MANAGEMENT_ENDPOINT=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod
